						 <&cpu6 7 THERMAL_NO_LIMIT>,
						 <&cpu7 7 THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu7-thermal {
			polling-delay-passive = <100>;
			polling-delay = <0>;
			thermal-sensors = <&tsens 6>;

			trips {
				cpu7_alert0: trip-point0 {
					temperature = <80000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu7_alert1: trip-point1 {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu7_alert2: trip-point2 {
					temperature = <100000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu7-crit {
					temperature = <110000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu7_alert0>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT 3>,
						 <&cpu5 THERMAL_NO_LIMIT 3>,
						 <&cpu6 THERMAL_NO_LIMIT 3>,
						 <&cpu7 THERMAL_NO_LIMIT 3>;
				};

				map1 {
					trip = <&cpu7_alert1>;
					cooling-device = <&cpu4 4 6>,
						 <&cpu5 4 6>,
						 <&cpu6 4 6>,
						 <&cpu7 4 6>;
				};

				map2 {
					trip = <&cpu7_alert2>;
					cooling-device = <&cpu4 7 THERMAL_NO_LIMIT>,
						 <&cpu5 7 THERMAL_NO_LIMIT>,
						 <&cpu6 7 THERMAL_NO_LIMIT>,
						 <&cpu7 7 THERMAL_NO_LIMIT>;
				};
			};
		};
	};
};

/*
 * Audio: the ADSP plays through QUAT MI2S (SD0) into the NXP TFA9890 speaker
 * amplifier on BLSP2 I2C5 (stock: qcom,msm-mi2s-rx-lines = <1>).
 */
/ {
	sound {
		compatible = "qcom,msm8994-sndcard";
		model = "OnePlus2";

		audio-routing = "AMIC2", "MIC BIAS2",
				"AMIC3", "MIC BIAS3",
				"AMIC4", "MIC BIAS1";

		reg = <0x0 0xfe037000 0x0 0x4>;
		reg-names = "lpaif_quat_mode_muxsel";

		pinctrl-0 = <&quat_mi2s_rx_default>;
		pinctrl-names = "default";

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
			};
		};

		speaker-dai-link {
			link-name = "Speaker";

			cpu {
				sound-dai = <&q6afedai QUATERNARY_MI2S_RX>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&speaker_amp>;
			};
		};

		headphones-dai-link {
			link-name = "Headphones";

			cpu {
				sound-dai = <&q6afedai SLIMBUS_0_RX>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd9330 0>;
			};
		};

		microphones-dai-link {
			link-name = "Microphones";

			cpu {
				sound-dai = <&q6afedai SLIMBUS_0_TX>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd9330 1>;
			};
		};
	};
};

/* loaded where the stock PIL puts it; the image is relocatable */
&adsp_pil {
	memory-region = <&peripheral_region>;
	firmware-name = "qcom/msm8994/oneplus/oneplus2/adsp.mbn";
};

&blsp2_i2c5 {
	/* stock runs this bus at 100 kHz */
	clock-frequency = <100000>;
	status = "okay";

	speaker_amp: audio-amplifier@36 {
		compatible = "nxp,tfa9890";
		reg = <0x36>;
		reset-gpios = <&tlmm 106 GPIO_ACTIVE_HIGH>;
		vddd-supply = <&vreg_s4a_1p8>;
		sound-name-prefix = "Speaker";
		#sound-dai-cells = <0>;
	};
};

&q6afedai {
	dai@22 {
		qcom,sd-lines = <0>;
	};
};

&q6asmdai {
	memory-region = <&audio_mem>;
};

&tlmm {
	quat_mi2s_rx_default: quat-mi2s-rx-default-state {
		pins = "gpio58", "gpio59", "gpio60";
		function = "qua_mi2s";
		drive-strength = <8>;
		bias-disable;
	};
};

/* The WCD9330 codec on SLIMbus: headset jack, earpiece and microphones */
&pm8994_gpios {
	wcd_mclk_default: wcd-mclk-default-state {
		pins = "gpio15";
		function = PMIC_GPIO_FUNC_FUNC1;
		power-source = <PM8994_GPIO_S4>;
		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
		bias-disable;
		input-disable;
		output-low;
	};
};

&slim {
	status = "okay";

	slim@1 {
		reg = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		wcd9330_ifd: ifd@0,0 {
			compatible = "slim217,130";
			reg = <0 0>;
		};

		wcd9330: codec@1,0 {
			compatible = "slim217,130";
			reg = <1 0>;
			slim-ifc-dev = <&wcd9330_ifd>;

			clocks = <&rpmcc RPM_SMD_DIV_CLK1>;
			clock-names = "mclk";
			interrupts-extended = <&tlmm 72 IRQ_TYPE_LEVEL_HIGH>;
			reset-gpios = <&tlmm 68 GPIO_ACTIVE_LOW>;

			pinctrl-0 = <&wcd_mclk_default>, <&wcd_intr_default>,
				    <&wcd_reset_default>;
			pinctrl-names = "default";

			vdd-buck-supply = <&vreg_s5a_2p15>;
			vdd-tx-h-supply = <&vreg_s4a_1p8>;
			vdd-rx-h-supply = <&vreg_s4a_1p8>;
			vdd-px-supply = <&vreg_s4a_1p8>;
			vdd-a-1p2v-supply = <&vreg_l11a_1p2>;
			vdd-cx1-supply = <&vreg_l11a_1p2>;
			vdd-cx2-supply = <&vreg_l11a_1p2>;

			qcom,mbhc-insert-detect-inverted;
			qcom,hph-class-ab;
			qcom,micbias1-microvolt = <1800000>;
			qcom,micbias2-microvolt = <2700000>;
			qcom,micbias3-microvolt = <1800000>;

			#sound-dai-cells = <1>;
		};
	};
};

&tlmm {
	wcd_intr_default: wcd-intr-default-state {
		pins = "gpio72";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	wcd_reset_default: wcd-reset-default-state {
		pins = "gpio68";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

/ {
	divclk4: divclk4 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "divclk4";
		pinctrl-names = "default";
		pinctrl-0 = <&divclk4_default>;
	};

	vreg_wlan_bt_3p3: wlan-bt-3p3-regulator {
		compatible = "regulator-fixed";
		regulator-name = "wlan_bt_3p3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pm8994_gpios 9 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <4000>;
		regulator-always-on;
		vin-supply = <&vph_pwr>;
		pinctrl-names = "default";
		pinctrl-0 = <&wlan_bt_3p3_en_default>;
	};

	vreg_wlan_en: wlan-en-regulator {
		compatible = "regulator-fixed";
		regulator-name = "wlan_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&tlmm 113 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <70000>;
		vin-supply = <&vreg_wlan_bt_3p3>;
		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en_default>;
	};
};

&blsp2_uart2 {
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "qcom,qca6174-bt";
		enable-gpios = <&pm8994_gpios 19 GPIO_ACTIVE_HIGH>;
		clocks = <&divclk4>;
	};
};

&pcie1 {
	vdda-supply = <&vreg_l28a_1p0>;
	status = "okay";
};

&pcie1_phy {
	vdda-phy-supply = <&vreg_l28a_1p0>;
	vdda-pll-supply = <&vreg_l12a_1p8>;
	status = "okay";
};

&pcie1_port {
	compatible = "pciclass,0604";
	reset-gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
	vpcie3v3-supply = <&vreg_wlan_en>;
};

&pm8994_gpios {
	pinctrl-names = "default";
	pinctrl-0 = <&bt_en_default>;

	bt_en_default: bt-en-default-state {
		pins = "gpio19";
		function = PMIC_GPIO_FUNC_NORMAL;
		power-source = <PM8994_GPIO_S4>;
		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
		bias-pull-down;
		output-high;
	};

	divclk4_default: divclk4-default-state {
		pins = "gpio18";
		function = PMIC_GPIO_FUNC_FUNC2;
		power-source = <PM8994_GPIO_S4>;
		bias-disable;
	};

	wlan_bt_3p3_en_default: wlan-bt-3p3-en-default-state {
		pins = "gpio9";
		function = PMIC_GPIO_FUNC_NORMAL;
		power-source = <PM8994_GPIO_VPH>;
		qcom,drive-strength = <PMIC_GPIO_STRENGTH_HIGH>;
		bias-disable;
	};
};

&tlmm {
	wlan_en_default: wlan-en-default-state {
		pins = "gpio113";
		function = "gpio";
		drive-strength = <16>;
		bias-pull-down;
	};
};
